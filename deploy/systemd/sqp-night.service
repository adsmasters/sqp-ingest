[Unit]
Description=night: alle taeglichen Jobs hintereinander (Vendor, Tagesdaten, Ads, audit-terms, ads-periodic, Marker) — ein Lauf, keine Leerlaufluecken
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=infinity
WorkingDirectory=/opt/sqp-ingest
EnvironmentFile=/opt/sqp-ingest/.env
# Nachtfenster-Schutz: ein Schritt, der erst nach 04:00 UTC beginnen wuerde, wird uebersprungen und gemeldet (siehe deploy/server-job.sh).
Environment=NIGHT_GUARD=1
Environment=NODE_OPTIONS=--max-old-space-size=1300
Environment=ADS_REFRESH_BUDGET_MIN=110
Environment=ADS_PERIODIC_BUDGET_MIN=150
Environment=AUDIT_CONCURRENCY=4
Environment=AUDIT_BUDGET_MIN=150
Environment=TERMS_CONCURRENCY=8
Environment=TERMS_BUDGET_MIN=90
# Reihenfolge (Review 21.11.2026): Vendor -> Verkaeufe & Traffic (frueh: die ASIN-Obergrenze von ads-periodic nutzt diese Daten) -> ads-refresh ->
# audit-terms (IDs vorladen) -> voller Audit (ersetzt danach den ganzen Inhalt) -> ads-periodic ZULETZT (falls die Kette zu lang wird, trifft
# der Nachtfenster-Schutz zuerst diesen Schritt) -> Marker "night/chain" (Kette bis zum Ende durchgelaufen; der Watchdog prueft diese Zeile).
# "-": scheitert ein Schritt, laufen die naechsten trotzdem (wie "if: always()" / eigene Workflows). Jeder Schritt meldet selbst.
# Testläufe 21.11.: Vendor 16 + 32, Sales & Traffic 16, ads-refresh ~85, audit-terms ~52, Audit 160, ads-periodic 83 Min = ~7,5 h ab 18:00 UTC. Echte Nächte 22./23.11.: fertig 21:30 / 21:54 UTC.
# vendor/sales (90 Min hartes Limit): ca. 8 Min + 10 Min je Kunde mit nicht fertigem Amazon-Bericht (erster Durchgang) + bis ca. 5–12 Min je Nachprüfung am Ende; das Skript startet ab 70 Min keine Nachprüfung mehr (VENDOR_DEADLINE_MIN).
ExecStart=-/usr/bin/bash /opt/sqp-ingest/deploy/server-job.sh vendor/sales 90 vendor-sales.mjs
ExecStart=-/usr/bin/bash /opt/sqp-ingest/deploy/server-job.sh vendor/ads 90 vendor-ads.mjs
ExecStart=-/usr/bin/bash /opt/sqp-ingest/deploy/server-job.sh daily-data/sales-traffic 150 sales-traffic.mjs 30
ExecStart=-/usr/bin/bash /opt/sqp-ingest/deploy/server-job.sh ads/refresh 150 ads-refresh.mjs
ExecStart=-/usr/bin/bash /opt/sqp-ingest/deploy/server-job.sh audit-terms 180 audit-terms-refresh.mjs 30
ExecStart=-/usr/bin/bash /opt/sqp-ingest/deploy/server-job.sh daily-data/audit 270 audit-refresh.mjs 30
ExecStart=-/usr/bin/bash /opt/sqp-ingest/deploy/server-job.sh ads/periodic 180 ads-periodic.mjs 4 3
# Marker + Zusammenfassung (night-summary.mjs, Sekunden): liest, was die 7 Schritte heute Nacht gemeldet haben, und endet mit Exit 1, wenn einer
# nicht erfolgreich war (systemd zeigt die Kette wegen "-" sonst IMMER als success). Bewusst OHNE "-": als letzter Schritt darf sein Fehler
# die Unit auf "failed" setzen (`systemctl status sqp-night`). Beginnt er nach dem Stichzeitpunkt, wird er vom Nachtfenster-Schutz uebersprungen.
ExecStart=/usr/bin/bash /opt/sqp-ingest/deploy/server-job.sh night/chain 5 night-summary.mjs
MemoryMax=1500M
OOMPolicy=continue
MemorySwapMax=0
Nice=10
CPUWeight=20
